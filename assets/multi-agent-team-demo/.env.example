# Copy this file to .env and fill in your key (.env is never committed/leaked).
# Never hard-code secrets in any code file.

# Option A: default provider (OpenAI-compatible API format)
LLM_API_KEY=sk-xxxx
LLM_MODEL=your-model-name

# Option B: another compatible provider (uncomment; usually cheaper)
# LLM_API_KEY=sk-other-xxxx
# LLM_MODEL=your-model-name
# LLM_BASE_URL=https://api.example.com/v1
